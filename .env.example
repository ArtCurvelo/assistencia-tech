# Exemplo de configuração do Assistência TECH.
# Copie para ".env" (ignorado pelo git) ou defina as variáveis no PowerShell:
#   $env:ASSISTENCIA_DATA_SOURCE = "demo"
# Nunca versione valores reais de credenciais (este arquivo não precisa de nenhuma:
# cada usuário entra com a própria conta).

# Fonte de dados: "demo" (padrão, dados em memória) ou "xano".
ASSISTENCIA_DATA_SOURCE=demo

# Endereço da instância Xano, sem "/api:..." (obrigatório quando a fonte for "xano").
XANO_BASE_URL=https://x8ki-letl-twmt.n7.xano.io

# Identificadores dos grupos de API (opcionais; padrões do backend em xano/).
# XANO_GROUP_AUTH=assistencia-tech-auth
# XANO_GROUP_CLIENTE=assistencia-tech-cliente
# XANO_GROUP_OS=assistencia-tech-os

# Tempo limite das requisições ao Xano, em segundos (padrão: 10).
XANO_TIMEOUT_SECONDS=10

# Endereço público do site, usado no QR code dos comprovantes (opcional).
# Sem ele, o QR code usa o endereço pelo qual a página foi aberta (em localhost,
# só funciona no próprio computador).
# ASSISTENCIA_PUBLIC_URL=https://assistencia.exemplo.com.br
