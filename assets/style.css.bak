
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  /* Cores de fundo */
  --bg: #030b16;
  --bg-secondary: #061426;
  --card: #081a2f;
  --card-hover: #0c223c;
  --input-bg: #030c18;

  /* Cores de destaque */
  --green: #39ff5a;
  --green-dark: #20c940;
  --blue: #087cff;
  --blue-light: #25a7ff;

  /* Texto e bordas */
  --text: #f1f5f9;
  --text-secondary: #91a4ba;
  --border: #123253;
  --border-strong: #1b4268;
  --focus: #25a7ff;

  /* Tipografia */
  --font-family: Inter, sans-serif;
  --font-size-xs: 11px;
  --font-size-sm: 13px;
  --font-size-base: 16px;

  /* Espaçamento */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-6: 24px;
  --space-8: 32px;

  /* Bordas e sombras */
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --shadow-card: 0 25px 70px rgba(0, 0, 0, 0.3);
  --shadow-focus: 0 0 0 3px rgba(37, 167, 255, 0.2);
  --transition: 180ms ease;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-height: 100%;
}

html {
  scroll-behavior: smooth;
}

body {
  background:
    radial-gradient(circle at 80% 10%, rgba(0, 255, 80, 0.08), transparent 30%),
    radial-gradient(circle at 10% 30%, rgba(0, 110, 255, 0.08), transparent 30%),
    var(--bg);
  color: var(--text);
  font-family: var(--font-family);
  font-size: var(--font-size-base);
  line-height: 1.5;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a,
input,
select,
textarea {
  -webkit-tap-highlight-color: transparent;
}

button {
  color: inherit;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

:focus-visible {
  outline: 2px solid var(--focus);
  outline-offset: 3px;
}

.app-root {
  min-height: 100vh;
}

.page-width {
  width: min(1250px, calc(100% - 48px));
  margin-inline: auto;
}

/* Cabeçalho público */

.public-header {
  height: 76px;
  border-bottom: 1px solid var(--border);
  background: rgba(3, 11, 22, 0.92);
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(15px);
}

.header-inner {
  height: 100%;
  display: flex;
  align-items: center;
  gap: 24px;
}

.brand-link {
  display: inline-block;
}

.brand-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: var(--green);
  color: #001006;
  font-size: 20px;
  box-shadow: 0 0 20px rgba(57, 255, 90, 0.25);
}

.brand-name {
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 0.2px;
}

.brand-sub {
  color: var(--green);
  font-size: 11px;
  letter-spacing: 2px;
  font-weight: 700;
}

.public-nav {
  display: flex;
  gap: 28px;
  color: var(--text-secondary);
  font-size: 14px;
}

.public-nav a:hover,
.accent-link:hover {
  color: var(--green);
}

.header-actions {
  display: flex;
  gap: 10px;
}

/* Botões */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  padding: 11px 18px;
  font-size: var(--font-size-sm);
  font-weight: 700;
  border: 1px solid transparent;
  cursor: pointer;
  transition:
    background var(--transition),
    border-color var(--transition),
    color var(--transition),
    box-shadow var(--transition),
    transform var(--transition);
  white-space: nowrap;
}

.btn-primary {
  background: var(--green);
  color: #001207;
}

.btn-primary:hover {
  background: #5cff76;
  box-shadow: 0 0 20px rgba(57, 255, 90, 0.2);
  transform: translateY(-1px);
}

.btn-outline {
  border-color: var(--border);
  color: var(--text);
  background: transparent;
}

.btn-outline:hover {
  border-color: var(--green);
  color: var(--green);
}

.full-width {
  width: 100%;
  margin-top: 22px;
}

/* Página inicial */

.hero-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 64px;
  align-items: center;
  padding-block: 78px;
}

.eyebrow {
  color: var(--green);
  font-size: var(--font-size-xs);
  font-weight: 800;
  letter-spacing: 1.5px;
  margin-bottom: 16px;
}

.hero-title {
  font-size: clamp(40px, 5vw, 68px);
  line-height: 1.06;
  letter-spacing: -2px;
}

.accent {
  color: var(--green);
  display: block;
}

.hero-copy {
  max-width: 620px;
  color: var(--text-secondary);
  line-height: 1.8;
  margin-block: 24px;
}

.hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.hero-card {
  padding: var(--space-8);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  background: linear-gradient(
    145deg,
    rgba(12, 38, 65, 0.92),
    rgba(4, 16, 30, 0.92)
  );
  box-shadow: var(--shadow-card);
}

.status-line {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: var(--text-secondary);
  font-size: var(--font-size-xs);
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 10px var(--green);
}

.hero-emoji {
  font-size: 60px;
  margin-block: 30px 12px;
}

.muted {
  color: var(--text-secondary);
  line-height: 1.7;
}

.tiny {
  font-size: 12px;
}

.accent-small {
  color: var(--green);
  font-size: 12px;
  font-weight: 600;
}

.divider {
  border-color: var(--border);
  margin-block: 24px;
}

/* Indicadores */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-block: 1px solid var(--border);
}

.stat-card {
  padding: 24px 16px;
  text-align: center;
  border-right: 1px solid var(--border);
}

.stat-card:last-child {
  border-right: 0;
}

.stat-value {
  color: var(--green);
  font-size: 30px;
  font-weight: 800;
}

.stat-label {
  color: var(--text-secondary);
  font-size: 12px;
  margin-top: 5px;
}

/* Seções e serviços */

.section {
  padding-block: 90px;
}

.section-heading {
  margin-bottom: 34px;
}

.section-heading h2 {
  margin-bottom: 10px;
}

.service-card {
  padding: 26px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  transition:
    background var(--transition),
    border-color var(--transition),
    transform var(--transition);
}

.service-card:hover {
  background: var(--card-hover);
  border-color: var(--green);
  transform: translateY(-4px);
}

.service-icon {
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: rgba(57, 255, 90, 0.08);
  font-size: 24px;
  margin-bottom: 20px;
}

.service-card h3 {
  margin-bottom: 10px;
}

.service-card p {
  font-size: var(--font-size-sm);
  margin-bottom: 18px;
}

.accent-link {
  color: var(--green);
  font-size: var(--font-size-sm);
  font-weight: 700;
}

/* Consulta de ordens */

.tracking {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 44px;
  padding: 46px;
  margin-block: 20px 90px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: linear-gradient(
    120deg,
    rgba(0, 110, 255, 0.08),
    rgba(57, 255, 90, 0.05)
  );
}

.tracking-box {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* Formulários */

.form-label {
  display: block;
  margin: 15px 0 7px;
  font-size: 12px;
  font-weight: 700;
  color: var(--text);
}

.input {
  width: 100%;
  background: var(--input-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
  padding: 12px 13px;
  outline: none;
  min-width: 0;
  transition:
    border-color var(--transition),
    box-shadow var(--transition);
}

.input::placeholder {
  color: var(--text-secondary);
  opacity: 0.8;
}

.input:focus {
  border-color: var(--focus);
  box-shadow: var(--shadow-focus);
}

.notice {
  color: var(--green);
  font-size: 12px;
  margin-top: 12px;
}

/* Chamada e rodapé */

.cta {
  text-align: center;
  padding: 90px 24px;
  border-top: 1px solid var(--border);
}

.cta p {
  color: var(--text-secondary);
  margin-block: 14px 26px;
}

.footer {
  border-top: 1px solid var(--border);
  padding-block: 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

/* Autenticação */

.auth-container {
  min-height: calc(100vh - 170px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50px 20px;
}

.auth-card {
  width: min(450px, 100%);
  padding: 36px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: var(--card);
}

.auth-heading {
  text-align: center;
  margin-bottom: 26px;
}

.auth-icon {
  display: grid;
  place-items: center;
  margin: 0 auto 18px;
  width: 54px;
  height: 54px;
  border-radius: 14px;
  color: var(--green);
  background: rgba(57, 255, 90, 0.1);
  font-size: 25px;
}

/* Cabeçalhos de páginas */

.page-header {
  padding-block: 80px 45px;
}

.page-header h1 {
  max-width: 800px;
}

.services-list {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding-bottom: 90px;
}

.service-large {
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: 26px;
  padding: 32px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
}

.service-large-icon {
  width: 76px;
  height: 76px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: rgba(57, 255, 90, 0.08);
  font-size: 34px;
}

.service-chip {
  padding: 7px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--green);
  font-size: 12px;
}

/* Painel administrativo */

.admin-layout {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 245px minmax(0, 1fr);
}

.sidebar {
  padding: 24px 18px;
  background: rgba(3, 11, 22, 0.95);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 26px;
  min-height: 100vh;
}

.sidebar-caption {
  color: var(--text-secondary);
  font-size: 10px;
  letter-spacing: 1.4px;
  font-weight: 800;
  margin-top: 16px;
}

.side-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  font-size: var(--font-size-sm);
  transition:
    background var(--transition),
    color var(--transition);
}

.side-link:hover {
  background: var(--card);
  color: var(--green);
}

.nav-icon {
  color: var(--green);
  width: 18px;
}

.side-back {
  color: var(--text-secondary);
  font-size: 12px;
  margin-top: auto;
}

.admin-main {
  min-width: 0;
}

.admin-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 30px 34px;
  border-bottom: 1px solid var(--border);
  background: rgba(6, 20, 38, 0.55);
}

.admin-topbar .eyebrow {
  margin-bottom: 8px;
}

.admin-topbar h1 {
  margin-bottom: 5px;
}

.demo-pill,
.demo-label {
  color: var(--green);
  border: 1px solid rgba(57, 255, 90, 0.3);
  background: rgba(57, 255, 90, 0.08);
  border-radius: 999px;
  padding: 7px 10px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.admin-content {
  padding: 28px 34px 50px;
}

.panel-card {
  padding: 24px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow-x: auto;
}

.panel-card h2,
.panel-card h3 {
  margin-bottom: 18px;
}

.panel-card table {
  font-size: 12px;
}

.panel-card th {
  color: var(--text-secondary);
}

.status-badge {
  border-radius: 999px;
  white-space: nowrap;
  font-size: 10px;
}

.status-recebido {
  background: rgba(8, 124, 255, 0.14);
  color: #70b6ff;
}

.status-em-análise {
  background: rgba(255, 190, 70, 0.14);
  color: #ffd078;
}

.status-em-reparo {
  background: rgba(57, 255, 90, 0.12);
  color: var(--green);
}

.status-concluído {
  background: rgba(145, 164, 186, 0.16);
  color: #c0cfdf;
}

.demo-notice {
  padding: 15px;
  border: 1px dashed var(--border);
  border-radius: 10px;
}

.search-input {
  max-width: 300px;
}

.status-select {
  min-width: 135px;
}

.empty-state {
  padding: 20px;
  text-align: center;
  color: var(--text-secondary);
}

/* Responsividade: tablets */

@media (max-width: 1000px) {
  .public-nav {
    display: none;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .stat-card:nth-child(2) {
    border-right: 0;
  }

  .stat-card:nth-child(-n + 2) {
    border-bottom: 1px solid var(--border);
  }

  .tracking {
    grid-template-columns: 1fr;
  }

  .admin-layout {
    grid-template-columns: 200px minmax(0, 1fr);
  }

  .admin-content {
    padding: 22px;
  }
}

/* Responsividade: celulares */

@media (max-width: 700px) {
  .page-width {
    width: min(calc(100% - 32px), 1250px);
  }

  .header-inner {
    gap: 12px;
  }

  .header-actions a:first-child {
    display: none;
  }

  .header-actions .btn {
    padding: 9px 10px;
    font-size: 11px;
  }

  .hero-grid {
    padding-block: 48px;
  }

  .hero-title {
    letter-spacing: -1px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .section {
    padding-block: 55px;
  }

  .tracking {
    padding: 24px;
    margin-inline: 16px;
  }

  .footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .service-large {
    grid-template-columns: 1fr;
    padding: 24px;
  }

  .admin-layout {
    grid-template-columns: 1fr;
  }

  .sidebar {
    min-height: unset;
    padding: 12px 16px;
    border-right: 0;
    border-bottom: 1px solid var(--border);
    gap: 12px;
  }

  .sidebar > .sidebar-caption,
  .side-back {
    display: none;
  }

  .sidebar > div:nth-child(3) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .side-link {
    padding: 8px;
    font-size: 11px;
  }

  .admin-topbar {
    padding: 22px 18px;
  }

  .admin-content {
    padding: 16px;
  }

  .panel-card {
    padding: 16px;
  }

  .auth-card {
    padding: 24px;
  }

  .service-large {
    gap: 18px;
  }
}

/* Respeita a preferência do usuário por menos animações */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* TESTE TEMPORÁRIO DE CARREGAMENTO */
.public-header {
  outline: 3px solid magenta !important;
}